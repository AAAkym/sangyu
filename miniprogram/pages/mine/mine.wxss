/* 底部预留自定义 tabBar 高度 + 安全区（custom-tabBar 不会自动让位） */
page {
  padding-bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom));
}

/* 「我的」页（设计令牌化）：身份头部 + 关系列表 + 设置菜单 */
.mine-header {
  display: flex;
  align-items: center;
}

.mine-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: var(--space-md);
  flex-shrink: 0;
}

.mine-avatar--sm {
  width: 72rpx;
  height: 72rpx;
  font-size: 40rpx;
  margin-right: var(--space-sm);
}

.mine-meta {
  flex: 1;
}

.mine-role-tag {
  font-size: var(--font-desc);
  color: var(--color-primary);
  background-color: var(--color-primary-soft);
  border-radius: var(--radius-full);
  padding: 6rpx 18rpx;
}

.mine-section {
  font-size: var(--font-desc);
  color: var(--color-text-tertiary);
  margin: var(--space-lg) var(--space-xs) var(--space-sm);
}

.mine-rel-row {
  display: flex;
  align-items: center;
}

.mine-rel-meta {
  flex: 1;
}

.mine-device-state {
  display: flex;
  align-items: center;
  font-size: var(--font-desc);
  color: var(--color-text-secondary);
  margin-right: var(--space-sm);
}

.status-dot-sm {
  width: 20rpx;
  height: 20rpx;
  border-radius: var(--radius-full);
  margin-right: var(--space-xs);
}

.unbind-btn {
  margin: 0;
  padding: 0 var(--space-md);
  height: 72rpx;
  display: flex;
  align-items: center;
  font-size: var(--font-desc);
  color: var(--color-danger);
  background-color: var(--color-danger-soft);
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.unbind-btn::after {
  border: none;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.menu-arrow {
  color: var(--color-text-tertiary);
  font-size: var(--font-title);
}

.logout-btn {
  margin-top: var(--space-xl);
  margin-bottom: var(--space-lg);
  height: 112rpx;
  border: 2rpx solid var(--sangyu-neutral-200);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-base);
  color: var(--color-danger);
  background-color: var(--color-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-1);
}

.logout-btn::after {
  border: none;
}

/* 菜单项：标题 + 一句说明（适老化：说明文字用辅助色，不小过 26rpx） */
.menu-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.menu-desc {
  font-size: var(--font-desc);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
  line-height: 1.5;
}

.menu-arrow {
  font-size: var(--font-title);
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

/* 开关（高对比/语音播报共用） */
.menu-switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-muted);
  position: relative;
  flex-shrink: 0;
  transition: background-color 200ms var(--ease-out);
}

.menu-switch--on {
  background-color: var(--color-success);
}

.menu-knob {
  position: absolute;
  top: 4rpx;
  left: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-card);
  box-shadow: var(--shadow-1);
  transition: left 200ms var(--ease-out);
}

.menu-switch--on .menu-knob {
  left: 42rpx;
}

/* 关于区：说明行距与次级标识 */
.about-box .about-line {
  line-height: 1.8;
}

.about-line--sub {
  color: var(--color-text-tertiary);
}

.logout-btn {
  margin-top: var(--space-xl);
  margin-bottom: var(--space-lg);
  height: 112rpx;
  border: 2rpx solid var(--sangyu-neutral-200);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-danger);
  background-color: var(--color-danger-soft);
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  font-weight: 600;
}

.logout-btn::after {
  border: none;
}

/* 头像上传后的图片填充 */
.mine-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

/* 预设头像色板圆点（点击更换） */
.preset-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: var(--space-md);
}

.preset-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-full);
  border: 4rpx solid var(--color-card);
  box-shadow: var(--shadow-1);
}

.menu-desc {
  overflow-wrap: anywhere;
}

/* 头像兜底：品牌符号（未设置头像时居中显示，不满铺） */
.mine-avatar-fallback {
  width: 64%;
  height: 64%;
  margin: auto;
  display: block;
}
