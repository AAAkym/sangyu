<view class="page {{fontClass}}">
  <view class="page-title">绑定老人</view>
  <view class="placeholder">请让老人在小程序「邀请家属」页生成邀请码，把 6 位数字输入这里完成绑定。</view>

  <input
    class="bind-input"
    type="number"
    maxlength="6"
    placeholder="请输入 6 位邀请码"
    value="{{code}}"
    bindinput="onInput"
  />
  <button class="bind-btn" loading="{{loading}}" bindtap="onBindTap">确认绑定</button>
</view>
