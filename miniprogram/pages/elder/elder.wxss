/* 底部预留自定义 tabBar 高度 + 安全区（custom-tabBar 不会自动让位） */
page {
  padding-bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom));
}

/* 老人首页（还原设计稿 elder-home.html：琥珀 Hero + SOS 红条 + 三宫格，尺寸 px→rpx×2） */

/* Hero 负边距抵消 .page 内边距，实现通栏头图 */
.hero {
  margin: calc(-1 * var(--space-lg)) calc(-1 * var(--space-lg)) 0;
  background-color: var(--color-primary);
  color: var(--color-primary-foreground);
  padding: 36rpx 40rpx 48rpx;
  border-bottom-left-radius: var(--radius-lg);
  border-bottom-right-radius: var(--radius-lg);
  box-shadow: var(--shadow-2);
}

.hero-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.brand {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.brand-logo {
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
  display: block;
}

/* 语音播报按钮（占用设计稿齿轮位） */
.speak-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  border-radius: var(--radius-full);
  background-color: rgba(255, 255, 255, 0.16);
}

.hero-greet {
  display: flex;
  align-items: center;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-primary-foreground);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-right: 28rpx;
  box-shadow: var(--shadow-1);
}

.greet-text {
  flex: 1;
  min-width: 0;
}

.greeting-name {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.18;
}

.greeting-date {
  font-size: 36rpx;
  font-weight: 500;
  margin-top: 6rpx;
  opacity: 0.92;
}

.device-status {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.status-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: var(--radius-full);
  margin-right: var(--space-sm);
}

.status-text {
  font-size: 32rpx;
  font-weight: 600;
}

.hero-pills {
  display: flex;
  margin-top: 36rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 12rpx var(--space-md);
  border-radius: var(--radius-full);
  font-size: 28rpx;
  font-weight: 600;
  background-color: rgba(255, 255, 255, 0.18);
}

/* 提醒卡：左侧琥珀强调条 */
.reminder-card {
  display: flex;
  align-items: stretch;
  background-color: var(--color-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-md);
  box-shadow: var(--shadow-1);
  margin-bottom: 40rpx;
  overflow: hidden;
}

.accent-strip {
  width: 8rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-primary);
  flex-shrink: 0;
  margin-right: 28rpx;
}

.reminder-content {
  flex: 1;
  min-width: 0;
}

.reminder-label {
  font-size: var(--font-desc);
  color: var(--color-text-secondary);
}

.reminder-title {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
  margin-top: 4rpx;
}

.reminder-meta {
  font-size: 30rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.reminder-meta .time {
  color: var(--color-primary);
  font-weight: 700;
}

.reminder-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  align-self: center;
}

/* SOS 实体红键（横向卡条，按住确认逻辑不变） */
.sos-btn {
  display: flex;
  align-items: center;
  width: 100%;
  background-color: var(--color-danger);
  color: var(--color-danger-foreground);
  border-radius: var(--radius-lg);
  padding: var(--space-md) 36rpx;
  min-height: 128rpx;
  box-shadow: var(--shadow-2);
  position: relative;
  overflow: hidden;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.sos-btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: inherit;
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.14);
  pointer-events: none;
}

.sos-btn--pressing {
  transform: scale(0.985);
  box-shadow: var(--shadow-1);
}

.sos-icon {
  font-size: 60rpx;
  margin-right: 28rpx;
}

.sos-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  text-align: left;
}

.sos-label {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.sos-desc {
  font-size: 30rpx;
  line-height: 1.3;
  opacity: 0.88;
  margin-top: 4rpx;
}

.sos-hint {
  min-height: 48rpx;
  margin: var(--space-sm) 0;
  text-align: center;
  font-size: var(--font-desc);
  color: var(--color-text-secondary);
}

/* 三宫格快捷入口 */
.qa-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-top: var(--space-md);
}

.qa-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background-color: var(--color-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  min-height: 208rpx;
  padding: 28rpx 24rpx;
  box-shadow: var(--shadow-1);
  transition: transform 0.15s ease;
}

.qa-card:active {
  transform: scale(0.97);
}

.qa-icon {
  font-size: 52rpx;
  margin-bottom: 20rpx;
}

.qa-label {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.25;
}

.qa-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
  line-height: 1.3;
}

/* 设置入口（三横线）：与语音播报并排，触达区 ≥88rpx */
.hero-actions {
  display: flex;
  align-items: center;
}

.gear-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: var(--radius-full);
  background-color: rgba(255, 255, 255, 0.16);
  margin-right: var(--space-sm);
}

.gear-line {
  width: 32rpx;
  height: 4rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-primary-foreground);
}

/* P1 老人端辨识度：去描边后恢复极浅分隔，确保卡片边界清晰 */
.entry {
  border: 1rpx solid var(--color-border);
}

.qa-card {
  animation: fade-up 0.4s var(--ease-out) backwards;
}

.qa-card:nth-child(2) {
  animation-delay: 0.06s;
}

.qa-card:nth-child(3) {
  animation-delay: 0.12s;
}

.qa-card:nth-child(4) {
  animation-delay: 0.18s;
}

.qa-card:nth-child(5) {
  animation-delay: 0.24s;
}
