/* 告警页（设计令牌化）：SOS 红边 / 设备预警橙边卡片 + 竖线时间线 + 状态胶囊 */

/* 卡片类型色边 */
.alert-card {
  border-left: 10rpx solid var(--color-danger);
}

.alert-card--device {
  border-left-color: var(--color-warning);
}

.alert-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.alert-title-wrap {
  flex: 1;
  margin-right: var(--space-sm);
}

/* 规则引擎告警的来源标签 */
.alert-tag-device {
  display: inline-block;
  margin-top: var(--space-xs);
  font-size: var(--font-desc);
  color: var(--color-warning-text);
  background-color: var(--color-warning-soft);
  border-radius: var(--radius-sm);
  padding: 2rpx var(--space-sm);
}

/* 状态胶囊（语义色软底 + 深色文字保证对比度） */
.alert-status {
  font-size: var(--font-desc);
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.alert-status--open {
  color: var(--color-danger);
  background-color: var(--color-danger-soft);
}

.alert-status--acknowledged {
  color: var(--color-info);
  background-color: var(--color-info-soft);
}

.alert-status--escalated,
.alert-status--external_dispatched {
  color: var(--color-warning-text);
  background-color: var(--color-warning-soft);
}

.alert-status--resolved {
  color: var(--color-success);
  background-color: var(--color-success-soft);
}

.alert-toggle {
  color: var(--color-info);
}

/* 时间线：竖线连接 + 节点圆点 */
.timeline {
  margin-top: var(--space-sm);
  padding: var(--space-md);
  background-color: var(--color-muted);
  border-radius: var(--radius-md);
}

.timeline__item {
  display: flex;
  margin-bottom: var(--space-md);
  position: relative;
  padding-left: 36rpx;
}

.timeline__item::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-primary);
}

.timeline__item::before {
  content: '';
  position: absolute;
  left: 15rpx;
  top: 34rpx;
  bottom: -22rpx;
  width: 2rpx;
  background-color: var(--color-border);
}

.timeline__item:last-child {
  margin-bottom: 0;
}

.timeline__item:last-child::before {
  display: none;
}

.timeline__time {
  width: 88rpx;
  font-size: var(--font-desc);
  color: var(--color-text-tertiary);
}

.timeline__body {
  flex: 1;
}

.timeline__line {
  font-size: var(--font-base);
}

.timeline__operator {
  color: var(--color-info);
  font-weight: 600;
  margin-right: var(--space-xs);
}

.timeline__note {
  font-size: var(--font-desc);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

/* 操作按钮组：同一状态可有多个动作（如 处理完成 / 转社区） */
.alert-actions {
  display: flex;
  margin-top: var(--space-md);
}

.alert-actions .alert-btn {
  flex: 1;
  margin: 0 var(--space-sm) 0 0;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-base);
  color: var(--color-primary-foreground);
  background-color: var(--color-primary);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-button);
}

.alert-actions .alert-btn:last-child {
  margin-right: 0;
}

.alert-btn::after {
  border: none;
}

/* 老人端 SOS：实体红圆钮（还原 elder-sos.html：220px 圆 + 内阴影立体 + 呼吸脉冲） */
.sos-btn {
  width: 440rpx;
  height: 440rpx;
  margin: var(--space-xl) auto var(--space-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background-color: var(--color-danger);
  border: 12rpx solid rgba(0, 0, 0, 0.22);
  color: var(--color-card);
  box-shadow:
    inset 0 12rpx 28rpx rgba(255, 255, 255, 0.22),
    inset 0 -20rpx 36rpx rgba(0, 0, 0, 0.28),
    0 28rpx 60rpx -20rpx rgba(198, 40, 40, 0.55);
  transition: transform 0.08s ease, box-shadow 0.12s ease;
  animation: sos-pulse 2.4s ease-out infinite;
}

/* 按压态：下沉 + 收敛阴影（按住 1 秒逻辑不变） */
.sos-btn--pressing {
  transform: translateY(6rpx);
  animation: none;
  box-shadow:
    inset 0 8rpx 20rpx rgba(255, 255, 255, 0.18),
    inset 0 -12rpx 24rpx rgba(0, 0, 0, 0.30),
    0 12rpx 28rpx -16rpx rgba(198, 40, 40, 0.5);
}

.sos-btn-word {
  font-size: 60rpx;
  font-weight: 800;
  letter-spacing: 0.06em;
  line-height: 1;
}

.sos-btn-sub {
  font-size: 26rpx;
  font-weight: 600;
  opacity: 0.92;
  letter-spacing: 0.04em;
  margin-top: var(--space-xs);
}

@keyframes sos-pulse {
  0% {
    box-shadow: inset 0 12rpx 28rpx rgba(255, 255, 255, 0.22), inset 0 -20rpx 36rpx rgba(0, 0, 0, 0.28), 0 28rpx 60rpx -20rpx rgba(198, 40, 40, 0.55), 0 0 0 0 rgba(198, 40, 40, 0.42);
  }
  70% {
    box-shadow: inset 0 12rpx 28rpx rgba(255, 255, 255, 0.22), inset 0 -20rpx 36rpx rgba(0, 0, 0, 0.28), 0 28rpx 60rpx -20rpx rgba(198, 40, 40, 0.55), 0 0 0 48rpx rgba(198, 40, 40, 0);
  }
  100% {
    box-shadow: inset 0 12rpx 28rpx rgba(255, 255, 255, 0.22), inset 0 -20rpx 36rpx rgba(0, 0, 0, 0.28), 0 28rpx 60rpx -20rpx rgba(198, 40, 40, 0.55), 0 0 0 0 rgba(198, 40, 40, 0);
  }
}

.sos-hint {
  min-height: 48rpx;
  text-align: center;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
}

.sos-hint-strong {
  color: var(--color-text);
  font-weight: 700;
}

/* 空状态（适老化：图标占位 + 明确指引） */
.empty-block {
  background-color: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-1);
  padding: var(--space-xl) var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-ico {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-muted);
  color: var(--color-text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-md);
}

.empty-ico .ico {
  width: 44rpx;
  height: 44rpx;
}

.empty-ico .ico::before,
.empty-ico .ico::after {
  background-color: var(--color-text-tertiary);
}

.empty-ico .ico-alert::before {
  background: transparent;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 22rpx solid var(--color-text-tertiary);
  left: 8rpx;
  top: 11rpx;
}

.empty-text {
  color: var(--color-text-secondary);
  line-height: 1.7;
  text-align: center;
  font-size: var(--font-base);
}

.timeline__note {
  overflow-wrap: anywhere;
}
