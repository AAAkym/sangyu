<view class="page {{fontClass}}">
  <view class="page-title">我的健康</view>

  <view class="entry today-card">
    <view class="today-label">今日心率</view>
    <view class="today-value">{{todayHr}}<text class="today-unit">次/分</text></view>
    <view class="today-status">
      <view class="status-dot" style="background-color: {{statusColor}}"></view>
      <text>{{statusText}}</text>
    </view>
  </view>

  <view class="entry">
    <view class="entry__title">最近 7 天</view>
    <canvas id="sparkline" type="2d" class="sparkline"></canvas>
  </view>

  <view class="source-line">{{sourceLine}}</view>
</view>
