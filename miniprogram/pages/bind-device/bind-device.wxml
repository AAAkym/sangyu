<view class="page {{fontClass}}">
  <view class="list-header">
    <view class="page-title">设备管理</view>
    <button class="bind-toggle" bindtap="toggleBindForm">{{showBindForm ? '收起' : '+ 绑定新设备'}}</button>
  </view>

  <view wx:if="{{showBindForm}}" class="entry">
    <view class="placeholder">输入机器人 / 健康设备的机身码（本地联调任意字符串即可，如 SB-001）。设备将绑定到老人身份名下。</view>
    <input class="bind-input" placeholder="请输入设备码" value="{{deviceCode}}" bindinput="onInput" />
    <button class="bind-btn" loading="{{binding}}" bindtap="onBindTap">确认绑定</button>
  </view>

  <view wx:if="{{!devices.length}}" class="placeholder">{{loading ? '加载中…' : '暂无绑定设备，点右上角「绑定新设备」开始。'}}</view>

  <view class="entry device-card" wx:for="{{devices}}" wx:key="id">
    <view class="device-row">
      <view class="device-dot" style="background-color: {{item.status === 'online' ? 'var(--color-success)' : 'var(--color-text-tertiary)'}}"></view>
      <view class="device-meta">
        <view class="entry__title">{{item.deviceCode}}</view>
        <view class="entry__desc">最后上报：{{item.lastReportText}}</view>
      </view>
      <view class="device-right">
        <view class="device-battery {{item.batteryLow ? 'device-battery--low' : ''}}">🔋 {{item.batteryText}}</view>
        <view class="device-status-text">{{item.status === 'online' ? '在线' : '离线'}}</view>
      </view>
    </view>
    <view class="device-footer">
      <button class="unbind-btn" catchtap="onUnbindTap" data-index="{{index}}">解绑</button>
    </view>
  </view>
</view>
